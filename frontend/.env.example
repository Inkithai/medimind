# Optional location-picker providers. Defaults combine Photon/OpenStreetMap
# landmark search with Open-Meteo/GeoNames city prefix matching.
# For production volume, point these at your hosted or commercial providers.
# VITE_GEOCODING_API_URL=https://photon.komoot.io
# VITE_CITY_GEOCODING_API_URL=https://geocoding-api.open-meteo.com/v1
# VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
