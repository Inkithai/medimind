{
  "name": "medimind-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "npm run test:hook && npm run test:auth && npm run test:i18n && npm run test:a11y && npm run test:geolocation && npm run test:care",
    "test:hook": "NODE_ENV=development tsx src/hooks/__tests__/useStrictEffect.test.tsx",
    "test:auth": "NODE_ENV=development tsx src/context/__tests__/AuthContext.test.tsx",
    "test:i18n": "NODE_ENV=development tsx src/i18n/__tests__/i18n.test.tsx",
    "test:a11y": "NODE_ENV=development tsx src/accessibility/__tests__/accessibility.test.tsx",
    "test:geolocation": "tsx src/services/__tests__/geolocation.test.ts",
    "test:care": "tsx src/components/__tests__/CareEvidencePanel.test.tsx && tsx src/components/__tests__/ConsultationPack.test.tsx && tsx src/components/__tests__/ProviderResultCard.test.tsx"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.13.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.23.11",
    "typescript": "^5.5.4",
    "vite": "^5.4.3"
  }
}
