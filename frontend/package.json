{
  "name": "medimind-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "npm run test:hook && npm run test:auth && npm run test:i18n && npm run test:a11y && npm run test:geolocation && npm run test:care && npm run test:sources && npm run test:safety-summary && npm run test:qacard && npm run test:format && npm run test:about && npm run test:timeline-empty && npm run test:judge-prep",
    "test:hook": "NODE_ENV=development tsx src/hooks/__tests__/useStrictEffect.test.tsx",
    "test:auth": "NODE_ENV=development tsx src/context/__tests__/AuthContext.test.tsx",
    "test:i18n": "NODE_ENV=development tsx src/i18n/__tests__/i18n.test.tsx",
    "test:a11y": "NODE_ENV=development tsx src/accessibility/__tests__/accessibility.test.tsx",
    "test:geolocation": "tsx src/services/__tests__/geolocation.test.ts",
    "test:care": "tsx src/components/__tests__/CareEvidencePanel.test.tsx && tsx src/components/__tests__/ConsultationPack.test.tsx && tsx src/components/__tests__/ProviderResultCard.test.tsx",
    "test:sources": "tsx src/utils/__tests__/sources.test.ts",
    "test:safety-summary": "tsx src/utils/__tests__/safety.test.ts",
    "test:qacard": "tsx src/components/__tests__/QAResultCard.test.tsx",
    "test:format": "TZ=Asia/Colombo tsx src/utils/__tests__/format.test.ts && TZ=America/New_York tsx src/utils/__tests__/format.test.ts && TZ=Pacific/Honolulu tsx src/utils/__tests__/format.test.ts && TZ=UTC tsx src/utils/__tests__/format.test.ts",
    "test:about": "tsx src/pages/__tests__/AboutPage.test.tsx",
    "test:timeline-empty": "NODE_ENV=development tsx src/pages/__tests__/timelineEmptyState.test.tsx",
    "test:judge-prep": "NODE_ENV=development tsx src/pages/__tests__/JudgePrepPage.test.tsx",
    "test:evidence": "tsx src/components/__smoke__/evidence-viewer.smoke.tsx",
    "test:clinical-events": "tsx src/components/__smoke__/clinical-events.smoke.tsx",
    "lint:eslint": "eslint src --max-warnings=0",
    "lint:format": "prettier --check \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.13.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.45",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.23.11",
    "typescript": "^5.5.4",
    "vite": "^5.4.3"
  }
}
