{
  "name": "medimind-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test:hook": "NODE_ENV=development tsx src/hooks/__tests__/useStrictEffect.test.tsx",
    "test:facilities": "tsx src/utils/__tests__/facilities.test.ts",
    "test:specialty": "tsx src/utils/__tests__/specialty.test.ts",
    "test:card": "tsx src/components/care/__tests__/FacilityCard.test.tsx",
    "test": "npm run test:facilities && npm run test:specialty && npm run test:card && npm run test:sources && npm run test:qacard && npm run test:format",
    "test:sources": "tsx src/utils/__tests__/sources.test.ts",
    "test:qacard": "tsx src/components/__tests__/QAResultCard.test.tsx",
    "test:format": "TZ=Asia/Colombo tsx src/utils/__tests__/format.test.ts && TZ=America/New_York tsx src/utils/__tests__/format.test.ts && TZ=Pacific/Honolulu tsx src/utils/__tests__/format.test.ts && TZ=UTC tsx src/utils/__tests__/format.test.ts"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.23.11",
    "typescript": "^5.5.4",
    "vite": "^5.4.3"
  }
}
