# LLM provider — picks backend + free-tier key (default: groq for backward compat)
# groq   : GROQ_API_KEY (gsk_...) — https://console.groq.com/keys
# gemini : GEMINI_API_KEY (or GOOGLE_API_KEY) — https://aistudio.google.com/app/apikey
# Provider quotas change; verify the active project/model limits in its console.
#          Gemini is multimodal and supports structured output. Quotas vary by project/model.
# Other OpenAI-compatible providers (cerebras, openrouter, openai, custom) via generic LLM_* vars — see bottom.
LLM_PROVIDER=groq
# LLM_PROVIDER=gemini

# ── Groq (default) — powers extraction, cross-checking, Q&A when LLM_PROVIDER=groq ──
# Free tier, no credit card: create a key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key

# Optional model overrides (defaults shown). Groq retires models on a
# schedule — if you get a 404 "model_not_found", check
# https://console.groq.com/docs/deprecations for the current replacement
# and set it here (no code change needed).
# GROQ_MODEL=openai/gpt-oss-120b          # text: extraction, cross-check, chat
# GROQ_VISION_MODEL=qwen/qwen3.6-27b      # images + scanned PDFs (multimodal)
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b  # cheap/fast text jobs

# ── Gemini (recommended free provider) — set LLM_PROVIDER=gemini + one of these keys ──
# Create/manage a key and view the project's current quota: https://aistudio.google.com/app/apikey
# OpenAI-compatible endpoint: https://generativelanguage.googleapis.com/v1beta/openai/
# GEMINI_API_KEY=your-gemini-api-key
# GOOGLE_API_KEY=your-google-api-key      # alt name for same key, also accepted
# Optional Gemini model/base overrides. Gemini 2.0 Flash was shut down
# 2026-06-01; do not configure it (the endpoint can misleadingly report quota=0).
# Current stable defaults shown:
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_VISION_MODEL=gemini-3.6-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# GEMINI_MAX_TOKENS=4096
# GEMINI_VISION_MAX_TOKENS=4096
# GEMINI_MAX_RATE_LIMIT_RETRIES=5

# ── Generic OpenAI-compatible (cerebras, openrouter, custom) — set LLM_PROVIDER to anything else ──
# For these, LLM_API_KEY + LLM_BASE_URL + LLM_MODEL drive the OpenAI SDK directly.
# Examples:
#   Cerebras (openai/gpt-oss-120b, 1M tokens/day free, no vision, 8K context cap):
#     LLM_PROVIDER=cerebras
#     LLM_API_KEY=csk-...
#     LLM_BASE_URL=https://api.cerebras.ai/v1
#     LLM_MODEL=openai/gpt-oss-120b
#   OpenRouter (many :free models, 20 RPM / 50 req/day free):
#     LLM_PROVIDER=openrouter
#     LLM_API_KEY=sk-or-...
#     LLM_BASE_URL=https://openrouter.ai/api/v1
#     LLM_MODEL=google/gemini-2.5-flash
#     LLM_VISION_MODEL=google/gemma-3-27b-it:free
# LLM_API_KEY=your-llm-api-key
# LLM_BASE_URL=https://api.example.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_VISION_MODEL=gpt-4o-mini
# LLM_FALLBACK_MODEL=gpt-4o-mini
# LLM_MAX_TOKENS=4096
# LLM_VISION_MAX_TOKENS=2048
# LLM_MAX_RATE_LIMIT_RETRIES=5

# ── Optional OpenRouter hard-quota fallback ────────────────────────────────
# OFF by default. When the primary provider returns an unrecoverable quota or
# retired-model error, subsequent LLM calls switch to OpenRouter for this
# backend process. This sends medical-document content to OpenRouter, so turn
# it on only after reviewing its privacy/data policies and obtaining the
# appropriate patient consent for your deployment.
# OPENROUTER_FALLBACK_ENABLED=true
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Choose models that support the structured JSON and image inputs this app sends.
# The dynamic router chooses an available model and filters for vision support.
# It is safer than pinning a :free model that may later be retired.
# OPENROUTER_FALLBACK_MODEL=openrouter/free
# OPENROUTER_FALLBACK_VISION_MODEL=openrouter/free

# Optional completion limits. Image tokens also count toward Groq's TPM cap,
# so vision defaults to 2048 even though text defaults to 4096. Keep the
# vision value at or below 2048 on Groq's 8K TPM on-demand tier. Check the
# active quota page before raising limits for any provider.
# GROQ_MAX_TOKENS=4096
# GROQ_VISION_MAX_TOKENS=2048
# LLM_MAX_TOKENS=4096
# LLM_VISION_MAX_TOKENS=2048

# How many consecutive 429 (rate-limit) waits a single LLM call may endure
# before failing fast with an actionable error instead of stalling the
# upload for many minutes. Waits honor Retry-After or Gemini RetryInfo;
# daily quota / limit=0 failures do not retry.
# GROQ_MAX_RATE_LIMIT_RETRIES=5
# GEMINI_MAX_RATE_LIMIT_RETRIES=5
# LLM_MAX_RATE_LIMIT_RETRIES=5

# Reasoning-model suppression for extraction calls. Reasoning models (the
# qwen vision default) emit <think> chain-of-thought that breaks Groq's
# server-side JSON validation and eats the capped vision token budget, so
# the extractor probes provider switches (enable_thinking=false /
# reasoning_format=hidden) and caches whatever works per model. "true"
# forces probing for every non-strict model (any provider), "false"
# disables probing entirely. Default (unset): probe only Groq models that
# look like thinkers.
# GROQ_DISABLE_REASONING=
# LLM_DISABLE_REASONING=

# Vector store — where RAG chunks are kept (no code change to switch).
# chroma:  local Chroma at CHROMA_DIR (needs Railway Volume at /data/chroma_db)
# supabase: Supabase `chunks` table (no volume, recommended for Railway)
# VECTOR_STORE=chroma
# VECTOR_STORE=supabase
# CHROMA_DIR=./chroma_db  # only for VECTOR_STORE=chroma

# Background jobs + per-file worker pool
# USE_BACKGROUND_JOBS=true  # POST /documents returns 202 + job polling
# Each document gets independent queued/reading/extracting/saving progress.
# Keep 1 for constrained/free quotas; raise only when the provider account supports it.
# UPLOAD_FILE_CONCURRENCY=1
# JOBS_POLL_INTERVAL_MS=1500

# Optional — Groq/Gemini have no embeddings API. If this OpenAI key is set it is
# used ONLY for Q&A embeddings (text-embedding-3-small). If left unset,
# embeddings run locally via Chroma's built-in ONNX MiniLM model instead.
# OPENAI_API_KEY=your-openai-api-key

CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Supabase (Postgres) — stores extracted documents + patient snapshots.
# URL: Dashboard -> Settings -> API -> Project URL
# Key: Dashboard -> Settings -> API -> service_role (secret)
# Also run supabase_schema.sql once in the SQL editor to create the tables.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

JWT_SECRET=your-jwt-signing-secret

# Optional: comma-separated list of allowed CORS origins for the browser
# frontend. Defaults to "*" (all origins) when unset. In production set this
# to your frontend's origin(s), e.g. "https://nalam.example.com".
# CORS_ORIGINS=https://nalam.example.com,https://app.example.com

# ── Find care ─────────────────────────────────────────────────────────────
# Primary: Geoapify Geocoding + Places (free, no credit card).
# Create a key at https://myprojects.geoapify.com/  (~3000 req/day free).
# Without this key, Find Care uses OpenStreetMap only.
# GEOAPIFY_API_KEY=your-geoapify-api-key
#
# Fallback (automatic, no key): OpenStreetMap Nominatim + Overpass.
# Leaflet on the frontend draws OSM tiles either way.
# NOMINATIM_URL=https://nominatim.openstreetmap.org/search
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# OSM_USER_AGENT=MediMind/1.0 (healthcare record assistant; https://github.com/Inkithai/medimind)
