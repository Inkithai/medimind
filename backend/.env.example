# LLM provider — picks backend + free-tier key (default: groq for backward compat)
# groq   : GROQ_API_KEY (gsk_...) — https://console.groq.com/keys
# gemini : GEMINI_API_KEY (or GOOGLE_API_KEY) — https://aistudio.google.com/app/apikey
# Provider quotas change; verify the active project/model limits in its console.
#          Gemini is multimodal and supports structured output. Quotas vary by project/model.
# Other OpenAI-compatible providers (cerebras, openrouter, openai, custom) via generic LLM_* vars — see bottom.
LLM_PROVIDER=groq
# LLM_PROVIDER=gemini

# Optional specialty fallback. Deterministic mappings always run first; when
# enabled, the model only resolves doctor-routed findings that otherwise fall
# back to general care. Failure keeps the general-care recommendation.
MEDIMIND_MODEL_SPECIALTY_SELECTION=false

# ── Groq (default) — powers extraction, cross-checking, Q&A when LLM_PROVIDER=groq ──
# Free tier, no credit card: create a key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key

# Optional model overrides (defaults shown). Groq retires models on a
# schedule — if you get a 404 "model_not_found", check
# https://console.groq.com/docs/deprecations for the current replacement
# and set it here (no code change needed).
# GROQ_MODEL=openai/gpt-oss-120b          # text: extraction, cross-check, chat
# GROQ_VISION_MODEL=qwen/qwen3.6-27b      # images + scanned PDFs (multimodal)
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b  # cheap/fast text jobs

# ── Gemini (recommended free provider) — set LLM_PROVIDER=gemini + one of these keys ──
# Create/manage a key and view the project's current quota: https://aistudio.google.com/app/apikey
# OpenAI-compatible endpoint: https://generativelanguage.googleapis.com/v1beta/openai/
# GEMINI_API_KEY=your-gemini-api-key
# GOOGLE_API_KEY=your-google-api-key      # alt name for same key, also accepted
# Optional Gemini model/base overrides. Gemini 2.0 Flash was shut down
# 2026-06-01; do not configure it (the endpoint can misleadingly report quota=0).
# Current stable defaults shown:
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_VISION_MODEL=gemini-3.6-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# GEMINI_MAX_TOKENS=4096
# GEMINI_VISION_MAX_TOKENS=4096
# GEMINI_MAX_RATE_LIMIT_RETRIES=5

# ── Generic OpenAI-compatible (cerebras, openrouter, custom) — set LLM_PROVIDER to anything else ──
# For these, LLM_API_KEY + LLM_BASE_URL + LLM_MODEL drive the OpenAI SDK directly.
# Examples:
#   Cerebras (openai/gpt-oss-120b, 1M tokens/day free, no vision, 8K context cap):
#     LLM_PROVIDER=cerebras
#     LLM_API_KEY=csk-...
#     LLM_BASE_URL=https://api.cerebras.ai/v1
#     LLM_MODEL=openai/gpt-oss-120b
#   OpenRouter (many :free models, 20 RPM / 50 req/day free):
#     LLM_PROVIDER=openrouter
#     LLM_API_KEY=sk-or-...
#     LLM_BASE_URL=https://openrouter.ai/api/v1
#     LLM_MODEL=google/gemini-2.5-flash
#     LLM_VISION_MODEL=google/gemma-3-27b-it:free
# LLM_API_KEY=your-llm-api-key
# LLM_BASE_URL=https://api.example.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_VISION_MODEL=gpt-4o-mini
# LLM_FALLBACK_MODEL=gpt-4o-mini
# LLM_MAX_TOKENS=4096
# LLM_VISION_MAX_TOKENS=2048
# LLM_MAX_RATE_LIMIT_RETRIES=5

# ── Optional OpenRouter hard-quota fallback ────────────────────────────────
# OFF by default. When the primary provider returns an unrecoverable quota or
# retired-model error, subsequent LLM calls switch to OpenRouter for this
# backend process. This sends medical-document content to OpenRouter, so turn
# it on only after reviewing its privacy/data policies and obtaining the
# appropriate patient consent for your deployment.
# OPENROUTER_FALLBACK_ENABLED=true
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Choose models that support the structured JSON and image inputs this app sends.
# The dynamic router chooses an available model and filters for vision support.
# It is safer than pinning a :free model that may later be retired.
# OPENROUTER_FALLBACK_MODEL=openrouter/free
# OPENROUTER_FALLBACK_VISION_MODEL=openrouter/free

# Optional completion limits. Image tokens also count toward Groq's TPM cap,
# so vision defaults to 2048 even though text defaults to 4096. Keep the
# vision value at or below 2048 on Groq's 8K TPM on-demand tier. Check the
# active quota page before raising limits for any provider.
# GROQ_MAX_TOKENS=4096
# GROQ_VISION_MAX_TOKENS=2048
# LLM_MAX_TOKENS=4096
# LLM_VISION_MAX_TOKENS=2048

# How many consecutive 429 (rate-limit) waits a single LLM call may endure
# before failing fast with an actionable error instead of stalling the
# upload for many minutes. Waits honor Retry-After or Gemini RetryInfo;
# daily quota / limit=0 failures do not retry.
# GROQ_MAX_RATE_LIMIT_RETRIES=5
# GEMINI_MAX_RATE_LIMIT_RETRIES=5
# LLM_MAX_RATE_LIMIT_RETRIES=5

# Reasoning-model suppression for extraction calls. Reasoning models (the
# qwen vision default) emit <think> chain-of-thought that breaks Groq's
# server-side JSON validation and eats the capped vision token budget, so
# the extractor probes provider switches (enable_thinking=false /
# reasoning_format=hidden) and caches whatever works per model. "true"
# forces probing for every non-strict model (any provider), "false"
# disables probing entirely. Default (unset): probe only Groq models that
# look like thinkers.
# GROQ_DISABLE_REASONING=
# LLM_DISABLE_REASONING=

# ── Live local care-provider search ────────────────────────────────
# Default auto: Geoapify first (if GEOAPIFY_API_KEY), else OpenStreetMap.
# PROVIDER_DIRECTORY_SOURCE=auto
# GEOAPIFY_API_KEY=your-geoapify-api-key   # https://myprojects.geoapify.com/
# OSM_NOMINATIM_USER_AGENT=MediMind/1.0 (contact: your-contact@example.com)
# Optional explicit: geoapify | openstreetmap | google_places
# GOOGLE_PLACES_API_KEY=your-google-places-api-key
# Optional public-source endpoints / limits (use only endpoints permitted for your deployment):
# OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
# OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
# OSM_PROVIDER_SEARCH_RADIUS_METERS=20000
# OSM_MIN_REQUEST_INTERVAL_SECONDS=1.0  # public-endpoint pacing, 0.2–5 seconds
# PROVIDER_SEARCH_TIMEOUT_SECONDS=12

# Vector store — where RAG chunks are kept (no code change to switch).
# chroma:  local Chroma at CHROMA_DIR (needs a Render Disk / Railway Volume at /data/chroma_db)
# supabase: Supabase `chunks` table (no disk/volume, recommended for Render/Railway)
# VECTOR_STORE=chroma
# VECTOR_STORE=supabase
# CHROMA_DIR=./chroma_db  # only for VECTOR_STORE=chroma

# Background jobs + per-file worker pool
# USE_BACKGROUND_JOBS=true  # POST /documents returns 202 + job polling
# Each document gets independent queued/reading/extracting/saving progress.
# Keep 1 for constrained/free quotas; raise only when the provider account supports it.
# UPLOAD_FILE_CONCURRENCY=1
# JOBS_POLL_INTERVAL_MS=1500
# Demo/placeholder detection is always logged, but matching pages are kept by
# default to avoid silently losing real records because of a name false-positive.
# Set true only when intentionally importing a pack that contains mock pages;
# structured clinical content is still kept even when its name matches a marker.
# SKIP_DEMO_DOCUMENTS=false

# Optional — Groq/Gemini have no embeddings API. If this OpenAI key is set it is
# used ONLY for Q&A embeddings (text-embedding-3-small). If left unset,
# embeddings run locally via Chroma's built-in ONNX MiniLM model instead.
# OPENAI_API_KEY=your-openai-api-key

# ---- Indexing memory controls (small containers) --------------------------
# Chunks embedded and upserted per batch. This is the main knob bounding peak
# memory during indexing: only one batch of texts + float vectors is alive at
# a time. 16 is tuned for a 512 MB container running the local ONNX MiniLM
# embedder; raise it on a larger instance to trade memory for speed.
# EMBEDDING_BATCH_SIZE=16
#
# Load the embedding model once at startup instead of in the middle of the
# first upload (where it collided with extraction results in memory). Set to
# false to go back to lazy loading on first index.
# PRELOAD_EMBEDDING_MODEL=true
#
# Where the local ONNX MiniLM weights (~79 MB) are cached. Point this at a
# baked-in image path or a persistent volume so a fresh container does not
# re-download them on the first upload.
# ONNX_MODEL_CACHE_DIR=/app/.cache/chroma

CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Supabase (Postgres) — stores extracted documents + patient snapshots.
# URL: Dashboard -> Settings -> API -> Project URL
# Key: Dashboard -> Settings -> API -> service_role (secret)
# Also run supabase_schema.sql once in the SQL editor to create the tables.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

JWT_SECRET=your-jwt-signing-secret

# Optional: comma-separated list of allowed CORS origins for the browser
# frontend. Defaults to "*" (all origins) when unset. In production set this
# to your frontend's origin(s), e.g. "https://nalam.example.com".
# CORS_ORIGINS=https://nalam.example.com,https://app.example.com

# Optional Care Navigation (decoupled from medical intelligence).
# CARE_NAVIGATION_PROVIDER=osm
# CARE_USER_AGENT=MediMind/1.0 (care navigation)
# MAPBOX_ACCESS_TOKEN=
# GOOGLE_MAPS_API_KEY=
#
# OSM provider resilience: the public Overpass instances rate-limit shared
# cloud IPs, so queries fail over across this comma-separated mirror list and
# identical lookups are cached. Point OVERPASS_URLS at an internal/paid
# mirror first for reliable production traffic.
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://overpass.private.coffee/api/interpreter
# OVERPASS_URL=https://overpass-api.de/api/interpreter   (legacy single-endpoint override)
# CARE_HTTP_TIMEOUT=25
# CARE_SEARCH_CACHE_TTL=300
# CARE_GEOCODE_CACHE_TTL=3600
#
# Legacy Find Care (care_finder.py) still accepts:
# GEOAPIFY_API_KEY=your-geoapify-api-key
# OSM_USER_AGENT=MediMind/1.0 (healthcare record assistant)
#
# ── Map-based Care Navigation / Find Care ────────────────────────
# Works with NO configuration: when CARE_PROVIDER is unset the backend uses
# OpenStreetMap (Overpass), which needs no API key, no billing, and no
# Google Cloud project. It reuses the OVERPASS_URLS mirrors above.
# CARE_PROVIDER=osm
#
# Optional: prefer Google Places API (New) and keep OpenStreetMap as an
# automatic fallback. Keep this key on the backend only. In Google Cloud,
# enable "Places API (New)" and attach billing, otherwise Google answers
# PERMISSION_DENIED and the fallback silently serves the results.
# A real Google API key normally starts with "AIza"; "AI" is not a valid key.
# CARE_PROVIDER=google
# GOOGLE_MAPS_API_KEY=AIza-your-real-server-key
#
# Set to "off" to disable the OpenStreetMap fallback and surface Google
# failures as 503s instead (not recommended):
# CARE_FALLBACK=on
# Optional request timeout (2-30 seconds, default 12):
# CARE_PROVIDER_TIMEOUT_SECONDS=12
# Optional only for a compatible test/proxy endpoint:
# GOOGLE_PLACES_BASE_URL=https://places.googleapis.com/v1

# ── Optional openFDA reference data (evidence-backed safety findings) ───────
# OFF by default. When OPENFDA_API_KEY is unset, every upload simply proceeds
# without FDA label citations, recall checks or NDC brand resolution —
# interaction/allergy findings grade as model knowledge (capped at 0.6) and no
# recall findings appear. Set the key to enable, per feature:
#   * drug/label.json  — cite the FDA-approved Structured Product Label when it
#     names the other drug involved in an interaction finding;
#   * drug/enforcement.json — flag medicines whose ingredient has a US recall,
#     framed as "reported in the US market";
#   * drug/ndc.json    — resolve a Latin-script brand name to its generic INN
#     deterministically instead of model recall.
# Free key (raises rate limits): https://open.fda.gov/apis/authentication/
# Keep this key backend-only, like the Cloudinary/Geoapify keys.
# openFDA is US-market data. A medicine missing from openFDA is silently left
# unmatched; absence is NOT treated as "no interaction" or "not recalled".
# OPENFDA_API_KEY=your-openfda-api-key
# OPENFDA_BASE_URL=https://api.fda.gov
# OPENFDA_HTTP_TIMEOUT=5
# OPENFDA_LABEL_CACHE_TTL=2592000   # seconds (30 days); labels change slowly
# OPENFDA_RECALL_CACHE_TTL=604800   # seconds (7 days); recalls change faster
# OPENFDA_NDC_CACHE_TTL=2592000     # seconds (30 days); NDC changes slowly
# OPENFDA_RECALL_LIMIT=10           # enforcement records fetched per ingredient
# OPENFDA_MAX_LABELS_PER_RECORD=40
# OPENFDA_PREFETCH_WORKERS=4

# ── Optional WHO antidote reference knowledge graph (Neo4j) ────────────────
# OFF by default. When unset, every upload simply proceeds without antidote
# reference notes and findings grade as model knowledge. Set these (and run
# POST /api/v1/knowledge-graph/antidotes with a WHO Model List of Essential
# Medicines PDF) to enable reference-graph evidence grading for antidotes.
# NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=your-password
# NEO4J_DATABASE=neo4j
# Optional connection-tuning (defaults shown):
# NEO4J_MAX_CONNECTION_LIFETIME=300
# NEO4J_LIVENESS_CHECK_TIMEOUT=30
# NEO4J_CONNECTION_ACQUISITION_TIMEOUT=30
# NEO4J_MAX_TRANSACTION_RETRY_TIME=15

# ── Optional offline OCR pre-pass (Tesseract) ──────────────────────────────
# OFF by default (auto-detected). When the tesseract binary + pytesseract are
# installed, scanned PDFs/images are OCR'd first: a confident transcript is
# extracted with the cheaper text model; otherwise the vision model runs as
# before. Never required — OCR absence leaves behavior unchanged.
# MEDIMIND_OCR_MIN_CONFIDENCE=60   # avg word confidence (0-100) to trust OCR
# MEDIMIND_OCR_DPI=200             # render DPI for scanned PDF pages

# ── Additional variables referenced in source ──────────────────────────────
# Audit logging master switch (default true).
# AUDIT_LOG=true
# Conversation session limits for the in-memory mirror.
# MAX_CONVERSATION_SESSIONS=50
# CONVERSATION_SESSION_TTL_SECONDS=86400
# PERSIST_SESSIONS=false
# Background job retention for the in-memory job registry.
# JOB_TTL_HOURS=24
# Use the Supabase jobs table instead of the in-memory registry.
# USE_SUPABASE_JOBS=false
# Legacy private-storage env aliases (Supabase Storage).
# DOCUMENT_STORAGE_BACKEND=cloudinary
# SUPABASE_STORAGE_BUCKET=medical-documents
# SUPABASE_KEY=your-supabase-anon-key
# SUPABASE_SERVICE_KEY=your-supabase-service-key
# QA context budget (characters) for complete-record retrieval.
# QA_CONTEXT_BUDGET_CHARS=12000
# Embedding model name override for the local ONNX embedder.
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# Provider rate-limit / token tuning used by the resilient LLM ladder.
# LLM_MAX_RPM=0
# LLM_FALLBACK_PROVIDER=
# FALLBACK_PROVIDER=
# OpenRouter fallback aliases (accepted by the fallback resolver).
# OPENROUTER_ENABLED=false
# OPENROUTER_FALLBACK=false
# OPENROUTER_DEFAULT_MODEL=openrouter/free
# OPENROUTER_MODEL=openrouter/free
# OPENROUTER_VISION_MODEL=openrouter/free
# FALLBACK_OPENROUTER_ENABLED=false
# Living-guidelines manifest URL for the guidelines refresh endpoint.
# LIVING_GUIDELINES_MANIFEST_URL=https://example.com/guidelines/manifest.json
# Internal-only bearer token for GET /metrics. When unset, /metrics is
# restricted to loopback/private ranges.
# METRICS_TOKEN=change-me
