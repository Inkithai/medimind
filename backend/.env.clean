# MediMind — clean .env (copy to backend/.env and fill values)
# Pick ONE provider: gemini (recommended free) or groq

# ── 1. LLM Provider ──────────────────────────────────────────────
LLM_PROVIDER=gemini
# Get free key (no card): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
# GOOGLE_API_KEY is accepted as alias for GEMINI_API_KEY

# If you prefer Groq instead, comment above and uncomment below:
# LLM_PROVIDER=groq
# GROQ_API_KEY=your-groq-api-key
# Free key (no card): https://console.groq.com/keys

# ── 2. Storage & DB (required) ──────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Run backend/supabase_schema.sql once in Supabase SQL Editor

# ── 3. Auth ──────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=your-jwt-signing-secret-change-this

# ── 4. Optional ──────────────────────────────────────────────────
# OPENAI_API_KEY=your-openai-api-key
# Only for embeddings (text-embedding-3-small). If unset, uses local ONNX — no key needed.

# CORS_ORIGINS=*
# CHROMA_DIR=./chroma_db

# ── 5. Live local care-provider search ────────────────────────────
# Default (auto): Geoapify first when keyed, OpenStreetMap fallback.
# GEOAPIFY_API_KEY=your-geoapify-api-key   # https://myprojects.geoapify.com/
# PROVIDER_DIRECTORY_SOURCE=auto
# OSM_NOMINATIM_USER_AGENT=MediMind/1.0 (contact: your-contact@example.com)
# OSM_USER_AGENT=MediMind/1.0 (healthcare record assistant)
# OSM_PROVIDER_SEARCH_RADIUS_METERS=20000
# OSM_MIN_REQUEST_INTERVAL_SECONDS=1.0
# PROVIDER_SEARCH_TIMEOUT_SECONDS=12
# Optional explicit source: geoapify | openstreetmap | google_places
# GOOGLE_PLACES_API_KEY=your-google-places-api-key
