# Keep Docker build context small — exclude everything the backend doesn't need
.git/
.gitignore
.env

# Frontend (deployed separately to Vercel)
frontend/

# Documentation, pitch decks and guides (all now live in docs/)
docs/
README.md
*.docx
*.pptx
generate_pptx.py

# Local data (never ship patient data in images)
chroma_db/
patient_report_*.json
patient_docs_*.json
backend/.env
backend/.env.clean

# Tests (not needed in production image)
backend/tests/

# Python cache
__pycache__/
*.pyc
.venv/

# IDE
.vscode/
.idea/
