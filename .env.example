# Grok (xAI) — powers document extraction, cross-checking, Q&A and
# conversation. Create a key at https://console.x.ai
XAI_API_KEY=your-xai-api-key

# Optional model overrides (defaults shown)
# GROK_MODEL=grok-4.5
# GROK_FALLBACK_MODEL=grok-4.3

# Optional — xAI has no embeddings API. If this OpenAI key is set it is
# used ONLY for Q&A embeddings (text-embedding-3-small). If left unset,
# embeddings run locally via Chroma's built-in ONNX MiniLM model instead.
# OPENAI_API_KEY=your-openai-api-key

CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Supabase (Postgres) — stores extracted documents + patient snapshots.
# URL: Dashboard -> Settings -> API -> Project URL
# Key: Dashboard -> Settings -> API -> service_role (secret)
# Also run supabase_schema.sql once in the SQL editor to create the tables.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

JWT_SECRET=your-jwt-signing-secret
